# ============================================================
# BOT.FOREX — Variables de entorno (copiar a .env y editar)
# ============================================================

# --- Seguridad -----------------------------------------------
# Clave para firmar los JWT. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIAME_clave_jwt_segura

# Clave Fernet para cifrar credenciales del broker. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CAMBIAME_clave_fernet_valida

# Minutos de validez del token de sesión
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Base de datos -------------------------------------------
# SQLite por defecto; para PostgreSQL:
#   postgresql+psycopg2://usuario:password@localhost:5432/botforex
DATABASE_URL=sqlite:///./botforex.db

# --- API / CORS ----------------------------------------------
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Entorno --------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
